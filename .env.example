# Correo de la cuenta administradora inicial (obligatorio).
# Al primer arranque, si no existe ningún usuario todavía, se crea
# automáticamente una cuenta admin con este correo y la contraseña de
# ADMIN_PASSWORD (o APP_PASSWORD si no defines ADMIN_PASSWORD). Todos los
# datos que ya existían en la base de datos quedan asignados a esa cuenta.
ADMIN_EMAIL=tu-correo@ejemplo.com

# Contraseña de la cuenta admin inicial. Si no la defines, se usa APP_PASSWORD.
ADMIN_PASSWORD=cambia-esto-por-una-clave-segura

# Compatibilidad: si ADMIN_PASSWORD no está definida, se usa esta.
APP_PASSWORD=cambia-esto-por-una-clave-segura

# Token secreto que usará el Atajo de iPhone para hablar con la API (obligatorio).
# También se usa para firmar las sesiones de inicio de sesión, así que no lo cambies
# a la ligera una vez la app esté en uso (cerraría la sesión de todos).
API_TOKEN=cambia-esto-por-otro-token-largo-y-aleatorio

# Dónde se guarda el archivo de la base de datos SQLite.
# En Railway/Render, apunta esto a una carpeta dentro de un volumen persistente.
DATABASE_PATH=/data/finanzas.db
