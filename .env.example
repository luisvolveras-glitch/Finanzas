# Contraseña para entrar al sitio web (obligatoria)
APP_PASSWORD=cambia-esto-por-una-clave-segura

# Token secreto que usará el Atajo de iPhone para hablar con la API (obligatorio)
API_TOKEN=cambia-esto-por-otro-token-largo-y-aleatorio

# Dónde se guarda el archivo de la base de datos SQLite.
# En Railway/Render, apunta esto a una carpeta dentro de un volumen persistente.
DATABASE_PATH=/data/finanzas.db
